# Hostinger FTP Setup Variables
# You can find these details in your Hostinger hPanel -> Website -> Dashboard -> FTP Accounts

# The FTP IP address (e.g., 193.203.166.xx) or hostname (e.g., ftp.yourdomain.com)
FTP_HOST=

# Your FTP Username
FTP_USER=

# Your FTP Password
FTP_PASSWORD=

# The folder where your website files are stored (Usually public_html)
FTP_REMOTE_DIR=public_html

# Set to true if FTPS is required, false for standard FTP. 
# Hostinger typically supports both, but true is recommended for security.
FTP_SECURE=false
